---
// One meter row at any scale. The state word is written
// for screen readers next to the number, so state never depends on colour.
import { level, levelWord } from '../lib/demo';
import Bar from './Bar.astro';

interface Props {
  label: string;
  reset?: string;
  used: number;
  pace?: number;
  big?: boolean;
  variant?: 'default' | 'widget';
  id?: string;
}

const { label, reset, used, pace, big = false, variant = 'default', id } = Astro.props;
const lvl = level(used);
const word = levelWord(used);
---

<div class:list={['meter', lvl, { 'meter-big': big, 'meter-widget': variant === 'widget' }]} data-meter={id}>
  <div class="meter-row">
    <span class="meter-label">{label}</span>
    {reset && <span class="meter-reset">{reset}</span>}
    <span class="meter-pct" data-pct>
      {used}%{word && <span class="sr-only"> used, {word}</span>}
    </span>
  </div>
  <Bar used={used} pace={pace} thickness={big ? 12 : 5} tick={big ? 24 : 9} tickWidth={big ? 3 : 2} level={lvl} />
</div>
